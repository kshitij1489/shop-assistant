# Copy to .env. Replace all three change-me values before starting.
SECRET_KEY=change-me-use-a-long-random-secret
JWT_SECRET=change-me-use-a-different-long-random-secret
POSTGRES_PASSWORD=change-me-use-a-random-database-password
POSTGRES_DB=studio_desk
POSTGRES_USER=studio_desk
POSTGRES_HOST=db
POSTGRES_PORT=5432

PUBLIC_URL=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to PUBLIC_URL; comma-separated origins if more than one is needed.
# CSRF_TRUSTED_ORIGINS=https://www.example.com
DEBUG=false
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
NGINX_SERVER_NAME=localhost
# Only for docker-compose.tls.yml; directory under /etc/letsencrypt/live/.
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
TLS_CERT_NAME=localhost
LETSENCRYPT_DIR=/etc/letsencrypt
CERTBOT_DIR=/var/www/certbot
STATIC_ROOT=/app/static

CELERY_BROKER_URL=redis://redis:6379/0
APP_SESSION_REDIS_URL=redis://redis:6379/1
APP_REDIS_URL=redis://redis:6379/2
HF_HOME=/model_cache

# Optional for setup/smoke checks; required for live AI conversations and audio.
OPENAI_API_KEY=
# Optional text-model overrides; all default to GPT-6 Luna when omitted.
LLM_MODEL=gpt-6-luna
LLM_TRANSLATE_MODEL=gpt-6-luna
LLM_ANALYTICS_MODEL=gpt-6-luna
# Optional geocoding; omit for the café information/menu demo.
# Tenants choose Google Maps or OpenStreetMap in settings. Google uses this key.
GOOGLE_MAPS_API_KEY=
# Site-location settings use Photon for autocomplete and Nominatim for validation.
# Configure a hosted/self-hosted Photon origin; this feature needs no Google key.
# PHOTON_BASE_URL=https://photon.example.com
# Nominatim-compatible origin for the OpenStreetMap choice. Leave unset to fail
# those lookups closed. Public Nominatim uses shared Redis ownership through each
# HTTP call, then a gap of at least 1 second. Busy/unavailable lookups are skipped.
# A 429 imposes Retry-After (or 60 seconds) across waiting workers too.
# NOMINATIM_BASE_URL=https://nominatim.example.com
# Public-host opt-in and crash recovery: docs/site_location.md
# NOMINATIM_API_KEY=
# NOMINATIM_USER_AGENT=ShopAssistant/1.0 (https://www.example.com)
# NOMINATIM_TIMEOUT_SECONDS=5
# NOMINATIM_MIN_INTERVAL_SECONDS=
# NOMINATIM_MAX_QUEUE_SECONDS=1
# Evaluation only: LOCATION_PROVIDER=emulator overrides every tenant and routes
# geocoding to the loopback mock_services location emulator (no Maps key needed).
# LOCATION_PROVIDER=google
# LOCATION_PROVIDER=openstreetmap forces Nominatim for every tenant.
# LOCATION_EMULATOR_URL=http://127.0.0.1:9080
# LOCATION_EMULATOR_TIMEOUT_SECONDS=3

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
SIGNUP_ALERT_EMAIL=

# Legacy filesystem -> MongoDB import only. Not needed by current runtime.
MONGO_DB_URL=
LEGACY_TENANT_SYNC_ENABLED=false
# Optional external adapter credentials; dashboard-issued credentials also work.
COMMERCE_ADAPTER_SECRETS={}
