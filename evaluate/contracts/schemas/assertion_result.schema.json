{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_instance_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
      "title": "Scenario Instance Id",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "event_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
      "title": "Event Id",
      "type": "string"
    },
    "assertion_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
      "title": "Assertion Id",
      "type": "string"
    },
    "original_turn_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Original Turn Index"
    },
    "request_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Request Id"
    },
    "evaluator": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
      "title": "Evaluator",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "ERROR",
        "SKIPPED",
        "COMPLETED",
        "NEEDS_REVIEW",
        "INTERRUPTED"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "criterion": {
      "title": "Criterion",
      "type": "string"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "execution_status": {
      "anyOf": [
        {
          "enum": [
            "COMPLETED",
            "BLOCKED",
            "ERROR",
            "INTERRUPTED",
            "SKIPPED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Status"
    },
    "evaluation_verdict": {
      "anyOf": [
        {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NEEDS_REVIEW"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Verdict"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "scenario_instance_id",
    "attempt",
    "event_id",
    "assertion_id",
    "original_turn_index",
    "request_id",
    "evaluator",
    "outcome",
    "criterion",
    "explanation",
    "evidence_ids"
  ],
  "title": "AssertionResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:studio-desk:evaluate:1.0.0:assertion_result"
}
