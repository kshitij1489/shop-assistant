{
  "$defs": {
    "ApplicationRevision": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[a-f0-9]{40,64}$",
          "title": "Commit",
          "type": "string"
        },
        "working_tree_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Working Tree Fingerprint",
          "type": "string"
        },
        "dirty": {
          "title": "Dirty",
          "type": "boolean"
        },
        "fingerprint_policy": {
          "const": "git-tracked-and-unignored-v1",
          "default": "git-tracked-and-unignored-v1",
          "title": "Fingerprint Policy",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "working_tree_fingerprint",
        "dirty"
      ],
      "title": "ApplicationRevision",
      "type": "object"
    },
    "ModelNames": {
      "additionalProperties": false,
      "properties": {
        "chat": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Chat",
          "type": "string"
        },
        "translate": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Translate",
          "type": "string"
        },
        "analytics": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Analytics",
          "type": "string"
        },
        "judge": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge"
        }
      },
      "required": [
        "chat",
        "translate",
        "analytics"
      ],
      "title": "ModelNames",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "application": {
      "$ref": "#/$defs/ApplicationRevision"
    },
    "dataset_hashes": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "title": "Dataset Hashes",
      "type": "object"
    },
    "configuration_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "scenario_plan_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scenario Plan Hash",
      "type": "string"
    },
    "scenario_plan_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
      "title": "Scenario Plan Version",
      "type": "string"
    },
    "models": {
      "$ref": "#/$defs/ModelNames"
    },
    "scenario_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
        "type": "string"
      },
      "title": "Scenario Ids",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "application",
    "dataset_hashes",
    "configuration_hash",
    "scenario_plan_hash",
    "scenario_plan_version",
    "models",
    "scenario_ids",
    "created_at"
  ],
  "title": "RunManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:studio-desk:evaluate:1.0.0:run_manifest"
}
