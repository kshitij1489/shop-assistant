{
  "$defs": {
    "OrderUpdate": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "order.updated",
          "title": "Type",
          "type": "string"
        },
        "accepted_order_id": {
          "format": "uuid",
          "title": "Accepted Order Id",
          "type": "string"
        },
        "external_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "sequence": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "status": {
          "enum": [
            "accepted",
            "preparing",
            "dispatched",
            "delivered",
            "rejected",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "type",
        "accepted_order_id",
        "external_id",
        "sequence",
        "status"
      ],
      "title": "OrderUpdate",
      "type": "object"
    },
    "PaymentUpdate": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "payment.updated",
          "title": "Type",
          "type": "string"
        },
        "payment_id": {
          "format": "uuid",
          "title": "Payment Id",
          "type": "string"
        },
        "external_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "sequence": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "authorized",
            "captured",
            "failed",
            "cancelled",
            "refunded"
          ],
          "title": "Status",
          "type": "string"
        },
        "captured_minor": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Captured Minor",
          "type": "integer"
        },
        "refunded_minor": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Refunded Minor",
          "type": "integer"
        },
        "checkout_url": {
          "default": "",
          "maxLength": 2000,
          "title": "Checkout Url",
          "type": "string"
        }
      },
      "required": [
        "type",
        "payment_id",
        "external_id",
        "sequence",
        "currency",
        "status",
        "captured_minor"
      ],
      "title": "PaymentUpdate",
      "type": "object"
    },
    "StockUpdate": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "inventory.updated",
          "title": "Type",
          "type": "string"
        },
        "stock_id": {
          "format": "uuid",
          "title": "Stock Id",
          "type": "string"
        },
        "sequence": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "on_hand": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "On Hand",
          "type": "integer"
        },
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "acknowledged_reservation_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Acknowledged Reservation Ids",
          "type": "array"
        }
      },
      "required": [
        "type",
        "stock_id",
        "sequence",
        "observed_at",
        "on_hand",
        "available"
      ],
      "title": "StockUpdate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "data": {
      "discriminator": {
        "mapping": {
          "inventory.updated": "#/$defs/StockUpdate",
          "order.updated": "#/$defs/OrderUpdate",
          "payment.updated": "#/$defs/PaymentUpdate"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PaymentUpdate"
        },
        {
          "$ref": "#/$defs/StockUpdate"
        },
        {
          "$ref": "#/$defs/OrderUpdate"
        }
      ],
      "title": "Data"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "occurred_at",
    "data"
  ],
  "title": "Event",
  "type": "object"
}
