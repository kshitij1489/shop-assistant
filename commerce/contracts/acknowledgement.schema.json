{
  "additionalProperties": false,
  "properties": {
    "lease_token": {
      "format": "uuid",
      "title": "Lease Token",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "retry",
        "unknown",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "error_code": {
      "default": "",
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9_.-]*$",
      "title": "Error Code",
      "type": "string"
    }
  },
  "required": [
    "lease_token",
    "outcome"
  ],
  "title": "Acknowledgement",
  "type": "object"
}
